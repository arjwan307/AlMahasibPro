# قيم جديدة مستقلة للمحاسب فقط؛ لا تضع أسرارًا في git.
PORT=5000
# قاعدة PostgreSQL مستقلة للمحاسب برو فقط.
DATABASE_URL=
# Keep this provider key in the server environment; never send it to the browser.
GROQ_API_KEY=
AI_ASSISTANT_GROQ_MODEL=openai/gpt-oss-20b
ALLOWED_ORIGINS=http://localhost:5000
SESSION_DAYS=14
# للاختبار والعرض المحلي المؤقت فقط، لا يحفظ البيانات بعد إعادة التشغيل:
# DATA_STORE=memory
PLATFORM_ADMIN_USERNAME=platform_admin
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=مدير المنصة
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
