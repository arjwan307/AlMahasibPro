{
  "extends": null,
  "win": {
    "target": [
      "nsis"
    ],
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "deleteAppDataOnUninstall": false,
    "script": "apps/retail/installer.nsi"
  },
  "files": [
    "apps/local/**",
    "apps/api/**",
    "apps/retail/**",
    "public/**",
    "package.json"
  ],
  "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
  "appId": "com.almahasibpro.retail",
  "productName": "AlMahasibPro-Retail",
  "directories": {
    "output": "releases/retail"
  },
  "extraMetadata": {
    "main": "apps/retail/main.cjs"
  }
}
