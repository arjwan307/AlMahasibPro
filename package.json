{
  "name": "almahaseb-pro",
  "version": "1.2.5",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node scripts/test.mjs",
    "db:migrate": "node database/migrate.js",
    "seed:platform-admin": "node database/seed-platform-admin.js",
    "start:enterprise": "node apps/local/enterprise-server.js",
    "desktop": "electron apps/desktop/main.cjs",
    "build:windows": "npm run build:windows:unified",
    "start:cloud": "node apps/api/src/cloud-server.js",
    "build:windows:company": "electron-builder --config apps/desktop/company-builder.json --win nsis --publish never",
    "build:windows:retail": "electron-builder --config apps/retail/retail-builder.json --win nsis",
    "desktop:retail": "electron apps/retail/main.cjs",
    "prebuild:windows:company": "node scripts/prepare-erp-shell.mjs",
    "prebuild:windows:retail": "node scripts/prepare-erp-shell.mjs",
    "build:windows:unified": "electron-builder --config apps/desktop/unified-builder.json --win nsis --publish never",
    "prebuild:windows:unified": "node scripts/prepare-erp-shell.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "mongodb": "^6.20.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "yauzl": "^3.4.0"
  },
  "type": "module",
  "overrides": {
    "exceljs": { "uuid": "11.1.1" }
  },
  "devDependencies": {
    "electron": "41.10.7",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.almahasibpro.enterprise",
    "productName": "AlMahasibPro",
    "directories": {
      "output": "releases/windows"
    },
    "files": [
      "apps/desktop/**",
      "apps/local/enterprise-server.js",
      "apps/api/**",
      "public/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "apps/desktop/main.cjs"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "script": "apps/desktop/installer.nsi",
      "installerLanguages": [
        "en_US",
        "ar"
      ]
    },
    "artifactName": "AlMahasibPro-Setup-${version}-${arch}.${ext}"
  },
  "description": "Company-owned offline accounting and inventory desktop for AlMahasibPro",
  "author": "AlMahasibPro",
  "engines": {
    "node": ">=22.16.0"
  }
}
